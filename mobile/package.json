{
  "name": "100x-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "detox:build:ios": "detox build --configuration ios.sim.release",
    "detox:test:ios": "detox test --configuration ios.sim.release --cleanup",
    "test:e2e": "npm run detox:build:ios && npm run detox:test:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "babel-preset-expo": "~58.0.24",
    "expo": "~58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-font": "58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "detox": "^20.51.4",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "typescript": "~5.9.2"
  }
}
