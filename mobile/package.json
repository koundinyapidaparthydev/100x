{
  "name": "aplifyai-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "detox:build:ios": "detox build --configuration ios.sim.release",
    "detox:test:ios": "detox test --configuration ios.sim.release --cleanup",
    "test:e2e": "npm run detox:build:ios && npm run detox:test:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.0",
    "expo": "^57.0.9",
    "expo-dev-client": "^57.0.10",
    "expo-linking": "^57.0.4",
    "expo-router": "^57.0.9",
    "expo-secure-store": "^57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-web-browser": "^57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "^19.2.3",
    "detox": "^20.51.4",
    "eslint": "^9.39.0",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "typescript": "~6.0.3"
  }
}
