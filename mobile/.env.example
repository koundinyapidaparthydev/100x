# iOS Simulator and local dev-client default:
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Android Emulator cannot reach the host through localhost. Use:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# A physical device needs the development machine's LAN address, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:4000/api/v1
