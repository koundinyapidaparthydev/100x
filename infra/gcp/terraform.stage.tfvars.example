# 100x stage environment in the shared non-production project.
# The stage input deliberately retains the existing "100x-staging-*"
# resource names so adopting this file does not rename the current stack.
project_id      = "jobseek-459701"
region          = "us-central1"
environment     = "stage"
vpc_subnet_cidr = "10.10.0.0/24"
cloud_run_image = ""

cloud_run_allow_unauthenticated = true
auth_allow_demo_login           = false

enable_static_cdn = true
static_domains    = ["stage.aplifyai.com"]

sql_deletion_protection = true

labels = {
  team    = "100x"
  product = "100x"
}
