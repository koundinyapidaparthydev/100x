# 100x development environment in the shared non-production project.
project_id       = "jobseek-459701"
region           = "us-central1"
environment      = "dev"
vpc_subnet_cidr  = "10.20.0.0/24"
cloud_run_image  = ""

cloud_run_allow_unauthenticated = true
auth_allow_demo_login           = true

enable_static_cdn = true
static_domains    = ["dev.aplifyai.com"]

sql_deletion_protection = true

labels = {
  team    = "100x"
  product = "100x"
}
