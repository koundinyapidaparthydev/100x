{
  "name": "100x-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Single backend for 100x — work items, PII firewall, AI orchestration, audit.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "test": "INCLUDE_SANDBOX_WORK_ITEMS=1 vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "bash scripts/run-integration.sh",
    "test:smoke-container": "bash scripts/smoke-container.sh",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
