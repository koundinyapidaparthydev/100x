# Backend environment (copy to .env locally — never commit secrets)

PORT=4000

# Required outside tests: stable 32+ character HMAC key for restart-safe sessions.
# Generate locally (for example: openssl rand -base64 32); never commit the value.
# AUTH_SESSION_SECRET=
# Demo identity login is disabled in production unless explicitly enabled.
# AUTH_ALLOW_DEMO_LOGIN=0

# H1 persistence — write store.json under ./data (or DATA_DIR)
PERSIST=1
# DATA_DIR=/absolute/path/to/data

# PostgreSQL snapshot persistence (takes precedence over file persistence).
# Supply DATABASE_URL from Secret Manager; never log or commit it.
# For Cloud SQL connector or private-IP connections, keep SSL disabled because
# transport security is provided by the connector/private network.
# DATABASE_URL=postgresql://user:password@host:5432/aplifyai
# DATABASE_SSL_MODE=disable
# Direct public connections can use require, or verify-full with a trusted CA.
# DATABASE_POOL_MAX=2
# DATABASE_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Live model providers (omit all → sandbox runner / canned drafts)
# Policy field model.provider: auto | openai | anthropic | openrouter
#   or OpenRouter aliases: deepseek | kimi | qwen | grok | nemotron
# "auto" = first configured key in order: openai → anthropic → openrouter
#
# Cursor / Composer / internal IDE models are NOT customer-keyed here.
# Grok and many open models: use OPENROUTER_API_KEY + openrouter model ids.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Example model ids: gpt-4o-mini, gpt-4o, o4-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Example model ids: claude-sonnet-4-20250514, claude-opus-4-20250514

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-app.example
# OPENROUTER_APP_TITLE=AplifyAI
# Example OpenRouter model ids (provider/model):
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4
#   deepseek/deepseek-chat
#   moonshotai/kimi-k2
#   qwen/qwen-2.5-72b-instruct
#   x-ai/grok-3-mini
#   nvidia/llama-3.1-nemotron-70b-instruct

# Optional live Jira Cloud connector (omit → sandbox board)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=...

# ---------------------------------------------------------------------------
# MCP remote transports (optional — omit → demo stub / auth-gated Connect)
# Tenant credentials (Connections UI) are primary; env values are fallbacks.
# Atlassian / Slack / GitLab / Microsoft / Google need OAuth client env for
# Authorize buttons (authorizeReady). Token providers unlock via PAT/API key.
# ---------------------------------------------------------------------------
# --- Atlassian (Jira / Confluence / Bitbucket) — set on staging Cloud Run ---
# MCP_ATLASSIAN_URL=https://mcp.atlassian.com/v1/sse
# MCP_ATLASSIAN_CLIENT_ID=
# MCP_ATLASSIAN_CLIENT_SECRET=
# MCP_ATLASSIAN_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/atlassian/callback
# MCP_ATLASSIAN_ACCESS_TOKEN=
# MCP_ATLASSIAN_AUTHORIZE_URL=https://auth.atlassian.com/authorize
# MCP_ATLASSIAN_TOKEN_URL=https://auth.atlassian.com/oauth/token
# --- GitHub (PAT via Connections; env fallback) ---
# MCP_GITHUB_URL=https://api.githubcopilot.com/mcp/
# MCP_GITHUB_TOKEN=
# --- Notion / Linear (API token via Connections; default MCP URLs) ---
# MCP_NOTION_URL=https://mcp.notion.com/mcp
# MCP_NOTION_TOKEN=
# MCP_LINEAR_URL=https://mcp.linear.app/mcp
# MCP_LINEAR_TOKEN=
# MCP_LINEAR_API_KEY=
# MCP_LINEAR_CLIENT_ID=
# MCP_LINEAR_CLIENT_SECRET=
# MCP_LINEAR_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/linear/callback
# MCP_LINEAR_ACCESS_TOKEN=
# --- GitLab.com OAuth + self-managed ---
# MCP_GITLAB_URL=https://gitlab.com/api/v4/mcp
# MCP_GITLAB_TOKEN=
# MCP_GITLAB_SM_URL=
# MCP_GITLAB_SM_TOKEN=
# MCP_GITLAB_CLIENT_ID=
# MCP_GITLAB_CLIENT_SECRET=
# MCP_GITLAB_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/gitlab/callback
# --- Slack (needs MCP_SLACK_URL + OAuth client for Authorize) ---
# MCP_SLACK_URL=
# MCP_SLACK_TOKEN=
# MCP_SLACK_CLIENT_ID=
# MCP_SLACK_CLIENT_SECRET=
# MCP_SLACK_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/slack/callback
# --- Microsoft (Teams / Outlook) ---
# MCP_MICROSOFT_URL=
# MCP_MICROSOFT_CLIENT_ID=
# MCP_MICROSOFT_CLIENT_SECRET=
# MCP_MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/microsoft/callback
# --- Google (Gmail / Drive) — MCP_* prefix avoids clashing with federated SSO GOOGLE_* ---
# MCP_GOOGLE_URL=
# MCP_GOOGLE_MCP_CLIENT_ID=
# MCP_GOOGLE_MCP_CLIENT_SECRET=
# MCP_GOOGLE_MCP_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/google/callback
# --- AWS / CloudWatch / GCP / Azure IAM ---
# MCP_AWS_URL=https://aws-mcp.us-east-1.api.aws/mcp
# AWS_ROLE_ARN=
# MCP_CLOUDWATCH_URL=
# MCP_CLOUDWATCH_TOKEN=
# MCP_GCP_URL=
# GCP_PROJECT_ID=
# MCP_AZURE_URL=
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# MCP_AZURE_DEVOPS_URL=
# MCP_AZURE_DEVOPS_TOKEN=
# AZURE_DEVOPS_PAT=
# --- Cursor bridge (honest — no fake Connected) ---
# MCP_CURSOR_BRIDGE_URL=
# --- Logging / observability MCP bridges ---
# MCP_DATADOG_URL=
# MCP_DATADOG_API_KEY=
# MCP_SPLUNK_URL=
# MCP_SPLUNK_TOKEN=
# MCP_ELASTICSEARCH_URL=
# MCP_ELASTICSEARCH_TOKEN=
# MCP_OPENSEARCH_URL=
# MCP_OPENSEARCH_TOKEN=
# MCP_NEW_RELIC_URL=
# MCP_NEW_RELIC_API_KEY=
# MCP_GRAFANA_LOKI_URL=
# MCP_GRAFANA_TOKEN=
# MCP_LOKI_URL=
# MCP_LOKI_TOKEN=

# ---------------------------------------------------------------------------
# Workspace invite email (Twilio SendGrid) — omit → stub outbox only
# From-address must be a verified sender / authenticated domain in SendGrid.
# ---------------------------------------------------------------------------
# SENDGRID_API_KEY=SG....
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=AplifyAI
# SENDGRID_SANDBOX=1

# ---------------------------------------------------------------------------
# Federated OIDC (optional — Google / Apple / Okta / Entra / Google Workspace)
# Full guide: docs/integrations/FEDERATED_SSO.md
# ---------------------------------------------------------------------------
# WEB_APP_ORIGIN=http://localhost:3000
# MOBILE_APP_ORIGIN=aplifyai://auth

# --- Okta ---
# OKTA_ISSUER=https://dev-xxxxxx.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_REDIRECT_URI=http://localhost:4000/api/v1/auth/okta/callback
# OKTA_DEFAULT_ROLE=manager
# OKTA_GROUP_ROLE_MAP={"AplifyAI-Owners":"founder","AplifyAI-Leads":"manager"}

# --- Microsoft Entra ID ---
# ENTRA_TENANT_ID=common
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:4000/api/v1/auth/entra/callback
# ENTRA_DEFAULT_ROLE=manager
# ENTRA_GROUP_ROLE_MAP={"AplifyAI-Owners":"founder"}

# --- Continue with Google ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# GOOGLE_DEFAULT_ROLE=root

# --- Google Workspace (company domain; may reuse GOOGLE_* client) ---
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google_workspace/callback
# GOOGLE_WORKSPACE_HD=yourcompany.com
# GOOGLE_WORKSPACE_DEFAULT_ROLE=manager

# --- Continue with Apple ---
# APPLE_CLIENT_ID=com.example.aplifyai.service
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/apple/callback
# APPLE_DEFAULT_ROLE=manager
