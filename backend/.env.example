# Backend environment (copy to .env locally — never commit secrets)

PORT=4000

# Required outside tests: stable 32+ character HMAC key for restart-safe sessions.
# Generate locally (for example: openssl rand -base64 32); never commit the value.
# AUTH_SESSION_SECRET=
# Demo identity login is disabled in production unless explicitly enabled.
# AUTH_ALLOW_DEMO_LOGIN=0

# H1 persistence — write store.json under ./data (or DATA_DIR)
PERSIST=1
# DATA_DIR=/absolute/path/to/data

# PostgreSQL snapshot persistence (takes precedence over file persistence).
# Supply DATABASE_URL from Secret Manager; never log or commit it.
# For Cloud SQL connector or private-IP connections, keep SSL disabled because
# transport security is provided by the connector/private network.
# DATABASE_URL=postgresql://user:password@host:5432/aplifyai
# DATABASE_SSL_MODE=disable
# Direct public connections can use require, or verify-full with a trusted CA.
# DATABASE_POOL_MAX=2
# DATABASE_CONNECT_TIMEOUT_MS=10000

# Optional live model (omit → sandbox runner)
# OPENAI_API_KEY=sk-...

# Optional live Jira Cloud connector (omit → sandbox board)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=...

# ---------------------------------------------------------------------------
# MCP remote transports (optional — omit → demo stub tools)
# Connect still works without these; live JSON-RPC uses them when set.
# ---------------------------------------------------------------------------
# MCP_ATLASSIAN_URL=https://mcp.atlassian.com/v1/sse
# MCP_ATLASSIAN_CLIENT_ID=
# MCP_ATLASSIAN_CLIENT_SECRET=
# MCP_ATLASSIAN_REDIRECT_URI=http://localhost:4000/api/v1/mcp/oauth/atlassian/callback
# MCP_ATLASSIAN_ACCESS_TOKEN=
# MCP_ATLASSIAN_AUTHORIZE_URL=https://auth.atlassian.com/authorize
# MCP_ATLASSIAN_TOKEN_URL=https://auth.atlassian.com/oauth/token
# MCP_GITHUB_URL=https://api.githubcopilot.com/mcp/
# MCP_GITHUB_TOKEN=
# MCP_NOTION_URL=https://mcp.notion.com/mcp
# MCP_NOTION_TOKEN=
# MCP_AWS_URL=https://aws-mcp.us-east-1.api.aws/mcp
# AWS_ROLE_ARN=

# ---------------------------------------------------------------------------
# Federated OIDC (optional — Google / Apple / Okta / Entra / Google Workspace)
# Full guide: docs/integrations/FEDERATED_SSO.md
# ---------------------------------------------------------------------------
# WEB_APP_ORIGIN=http://localhost:3000
# MOBILE_APP_ORIGIN=aplifyai://auth

# --- Okta ---
# OKTA_ISSUER=https://dev-xxxxxx.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_REDIRECT_URI=http://localhost:4000/api/v1/auth/okta/callback
# OKTA_DEFAULT_ROLE=manager
# OKTA_GROUP_ROLE_MAP={"AplifyAI-Owners":"founder","AplifyAI-Leads":"manager"}

# --- Microsoft Entra ID ---
# ENTRA_TENANT_ID=common
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=http://localhost:4000/api/v1/auth/entra/callback
# ENTRA_DEFAULT_ROLE=manager
# ENTRA_GROUP_ROLE_MAP={"AplifyAI-Owners":"founder"}

# --- Continue with Google ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# GOOGLE_DEFAULT_ROLE=root

# --- Google Workspace (company domain; may reuse GOOGLE_* client) ---
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=
# GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google_workspace/callback
# GOOGLE_WORKSPACE_HD=yourcompany.com
# GOOGLE_WORKSPACE_DEFAULT_ROLE=manager

# --- Continue with Apple ---
# APPLE_CLIENT_ID=com.example.aplifyai.service
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/apple/callback
# APPLE_DEFAULT_ROLE=manager
